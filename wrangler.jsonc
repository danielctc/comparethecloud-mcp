{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ctc-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "mcp.comparethecloud.net", "custom_domain": true }],
  "kv_namespaces": [{ "binding": "MCP_KEYS", "id": "7ed3b23ca97f4873a756981b0b246b7c" }],
  // Same-zone subrequests from a Worker bypass the www Worker, so call it through a service binding.
  "services": [{ "binding": "SITE", "service": "compare-the-cloud" }],
  "unsafe": {
    "bindings": [
      { "name": "RL_ANON", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
      { "name": "RL_KEY", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
    ]
  },
  // Daily quotas and the not-found block need a counter that outlives the 60-second ratelimit window.
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "QuotaCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaCounter"] }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "SITE_ORIGIN": "https://www.comparethecloud.net",
    "RESEND_FROM": "Compare the Cloud <mcp@comparethecloud.net>",
    "PUBLIC_ORIGIN": "https://mcp.comparethecloud.net",
    // OpenAI's connector egress ranges change, so they are read from the published manifest daily.
    "OPENAI_CONNECTOR_RANGES_URL": "https://openai.com/chatgpt-connectors.json",
    // OAuth sign-in (/auth/mcp and its metadata): off until ctc-auth release/r1, W1 and the ctc-mcp
    // introspection client are live. Only "true" turns it on. Secrets: CTC_MCP_CLIENT_ID, CTC_MCP_CLIENT_SECRET.
    "OAUTH_ENABLED": "false"
  },
  "observability": { "enabled": false }
}
